---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import SocialProof from '../components/home/SocialProof.astro';
import ProblemSolution from '../components/home/ProblemSolution.astro';
import Principles from '../components/home/Principles.astro';
import AutonomousAgents from '../components/home/AutonomousAgents.astro';
import OpenSource from '../components/home/OpenSource.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { SITE } from '../data/site';
import { FAQ } from '../data/faq';

// Title 53 chars, description from SITE (≤155).
const title = 'Calyflow: Agentic Recruiting';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE.name,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: SITE.definition,
    url: SITE.url,
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    sameAs: [SITE.githubUrl],
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout title={title} description={SITE.description} jsonLd={jsonLd}>
  <Hero />
  <SocialProof />
  <ProblemSolution />
  <AutonomousAgents />
  <Principles />
  <OpenSource />
  <Faq />
  <FinalCta />
</BaseLayout>
