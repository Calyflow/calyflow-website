---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Breadcrumbs from '../../../components/blog/Breadcrumbs.astro';
import { TOPICS } from '../../../content.config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return TOPICS.map((topic) => ({
    params: { topic },
    props: {
      posts: posts
        .filter((p) => p.data.topic === topic)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  })).filter(({ props }) => props.posts.length > 0);
}

const { topic } = Astro.params;
const { posts } = Astro.props;
const label = topic.replace(/-/g, ' ');
const capitalized = label.replace(/\b\w/g, (c) => c.toUpperCase());
const title = `${capitalized} — Calyflow Blog`;
const description = `Articles on ${label} for recruiting teams: practical, workflow-first guides from Calyflow.`;
---

<BaseLayout title={title} description={description}>
  <section class="relative">
    <div class="relative mx-auto max-w-6xl px-5 pt-16 pb-10 md:pt-20">
      <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: capitalized }]} />
      <h1 class="mt-6 text-3xl tracking-tight capitalize md:text-4xl">{label}</h1>
      <p class="mt-4 max-w-2xl text-xl text-navy-800/70">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} on {label}.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
