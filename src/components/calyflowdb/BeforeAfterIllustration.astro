---
/**
 * Before/after split: Boolean-string chaos on the left, an AI agent
 * returning ranked, evidence-backed candidates on the right.
 */
---

<svg
  viewBox="0 0 880 380"
  fill="none"
  role="img"
  aria-label="Split diagram: chaotic Boolean keyword search on the left versus an AI agent returning ranked candidates with evidence on the right"
  class="h-auto w-full"
>
  <!-- BEFORE panel -->
  <rect x="4" y="4" width="416" height="372" rx="8" fill="var(--color-cream-100)"></rect>
  <rect x="4" y="4" width="416" height="372" rx="8" stroke="var(--color-navy-800)" stroke-opacity="0.1" stroke-width="1.5"></rect>
  <rect x="24" y="24" width="74" height="24" rx="8" fill="var(--color-navy-800)" opacity="0.08"></rect>
  <text x="61" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="11" letter-spacing="1" fill="var(--color-navy-800)" opacity="0.7">BEFORE</text>

  <!-- scattered tabs behind -->
  <g stroke="var(--color-navy-800)" stroke-opacity="0.14" stroke-width="1.5" fill="white">
    <rect x="40" y="188" width="150" height="92" rx="6" transform="rotate(-5 115 234)"></rect>
    <rect x="230" y="200" width="160" height="86" rx="6" transform="rotate(4 310 243)"></rect>
    <rect x="120" y="256" width="180" height="90" rx="6" transform="rotate(-2 210 301)"></rect>
  </g>
  <g fill="var(--color-navy-800)" opacity="0.1">
    <rect x="58" y="210" width="100" height="6" rx="3" transform="rotate(-5 108 213)"></rect>
    <rect x="58" y="226" width="80" height="6" rx="3" transform="rotate(-5 98 229)"></rect>
    <rect x="248" y="222" width="110" height="6" rx="3" transform="rotate(4 303 225)"></rect>
    <rect x="248" y="238" width="86" height="6" rx="3" transform="rotate(4 291 241)"></rect>
    <rect x="140" y="282" width="130" height="6" rx="3" transform="rotate(-2 205 285)"></rect>
    <rect x="140" y="298" width="96" height="6" rx="3" transform="rotate(-2 188 301)"></rect>
  </g>

  <!-- boolean search box -->
  <rect x="28" y="66" width="368" height="96" rx="8" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.2" stroke-width="1.5"></rect>
  <text font-family="var(--font-mono)" font-size="12" fill="var(--color-navy-800)" opacity="0.65">
    <tspan x="44" y="94">("java" AND spring) AND (aws</tspan>
    <tspan x="44" y="114">OR gcp) NOT junior AND</tspan>
    <tspan x="44" y="134">("fintech" OR bank* OR paym*)</tspan>
  </text>
  <!-- amber squiggle -->
  <path
    d="M44 146 q6 5 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0"
    stroke="var(--color-amber-400)"
    stroke-width="1.75"
    stroke-linecap="round"
  ></path>

  <!-- zero results tag -->
  <rect x="228" y="330" width="168" height="26" rx="6" fill="var(--color-amber-400)" opacity="0.18"></rect>
  <text x="312" y="347" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-navy-800)" opacity="0.75">0 of 4,382 surfaced</text>

  <!-- divider arrow -->
  <circle cx="440" cy="190" r="22" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.2" stroke-width="1.5"></circle>
  <path d="M432 190h15m0 0-5.5-5.5M447 190l-5.5 5.5" stroke="var(--color-mint-700)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>

  <!-- AFTER panel -->
  <rect x="460" y="4" width="416" height="372" rx="8" fill="white"></rect>
  <rect x="460" y="4" width="416" height="372" rx="8" stroke="var(--color-mint-400)" stroke-opacity="0.55" stroke-width="1.5"></rect>
  <rect x="480" y="24" width="66" height="24" rx="8" fill="var(--color-mint-400)" opacity="0.25"></rect>
  <text x="513" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="11" letter-spacing="1" fill="var(--color-mint-700)">AFTER</text>

  <!-- natural language ask -->
  <rect x="484" y="66" width="368" height="58" rx="6" fill="var(--color-cream-50)" stroke="var(--color-navy-800)" stroke-opacity="0.18" stroke-width="1.5"></rect>
  <circle cx="514" cy="95" r="10" stroke="var(--color-mint-700)" stroke-width="2"></circle>
  <path d="m521 102 7 7" stroke="var(--color-mint-700)" stroke-width="2" stroke-linecap="round"></path>
  <text font-family="var(--font-display)" font-size="13" fill="var(--color-navy-800)">
    <tspan x="540" y="90">"Senior backend engineer, built</tspan>
    <tspan x="540" y="108">payment systems, open to remote EU"</tspan>
  </text>

  <!-- ranked results -->
  {
    [
      { y: 144, score: '94%', chips: ['payments', 'K8s', 'regulated'], op: 1 },
      { y: 216, score: '89%', chips: ['fintech', 'AWS'], op: 0.85 },
      { y: 288, score: '83%', chips: ['SaaS', 'platform'], op: 0.7 },
    ].map((r, i) => (
      <g opacity={r.op}>
        <rect x="484" y={r.y} width="368" height="60" rx="8" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.15" stroke-width="1.5" />
        <circle cx="512" cy={r.y + 30} r="13" fill={i === 0 ? 'var(--color-mint-400)' : 'var(--color-sky-300)'} opacity="0.45" />
        <circle cx="512" cy={r.y + 30} r="13" stroke="var(--color-navy-800)" stroke-opacity="0.4" stroke-width="1.5" />
        <rect x="536" y={r.y + 14} width={92 - i * 10} height="8" rx="4" fill="var(--color-navy-800)" opacity="0.25" />
        {r.chips.map((c, j) => (
          <g>
            <rect x={536 + j * 74} y={r.y + 32} width={66} height="16" rx="8" fill="var(--color-mint-400)" opacity="0.2" />
            <text x={569 + j * 74} y={r.y + 43} text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-mint-700)">
              {c}
            </text>
          </g>
        ))}
        <rect x="796" y={r.y + 16} width="42" height="20" rx="6" fill="var(--color-mint-400)" opacity={i === 0 ? 0.9 : 0.35} />
        <text x="817" y={r.y + 30} text-anchor="middle" font-family="var(--font-mono)" font-size="10" font-weight="600" fill="var(--color-navy-900)">
          {r.score}
        </text>
      </g>
    ))
  }
  <text x="668" y="364" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1" fill="var(--color-navy-800)" opacity="0.5">RANKED · WITH EVIDENCE</text>
</svg>
