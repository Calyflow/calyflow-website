---
/**
 * Hero: scattered recruiting data sources flowing into a central
 * "AI Talent Memory" database, with agent outputs on the right.
 * Duotone-line style per DESIGN.md §5, brand palette only.
 */
---

<svg
  viewBox="0 0 640 520"
  fill="none"
  role="img"
  aria-label="Diagram: ATS, CRM, email, calls and spreadsheets flowing into a central AI talent memory, which feeds shortlists, match explanations and outreach drafts"
  class="h-auto w-full"
>
  <defs>
    <linearGradient id="hero-glow" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="var(--color-mint-400)"></stop>
      <stop offset="100%" stop-color="var(--color-sky-300)"></stop>
    </linearGradient>
    <filter id="hero-blur" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="28"></feGaussianBlur>
    </filter>
  </defs>

  <!-- glow behind the database -->
  <ellipse cx="320" cy="250" rx="120" ry="95" fill="url(#hero-glow)" opacity="0.4" filter="url(#hero-blur)"></ellipse>

  <!-- flow lines: sources → database -->
  <g stroke="var(--color-navy-800)" stroke-opacity="0.22" stroke-width="1.5">
    <path d="M126 66 C 200 66 215 190 262 218"></path>
    <path d="M126 154 C 190 154 210 205 260 232"></path>
    <path d="M126 242 C 180 242 210 245 258 250"></path>
    <path d="M126 330 C 190 330 210 290 260 268"></path>
    <path d="M126 418 C 200 418 215 305 262 282"></path>
  </g>
  <!-- flow lines: database → outputs -->
  <g stroke="var(--color-navy-800)" stroke-opacity="0.22" stroke-width="1.5">
    <path d="M382 222 C 430 195 430 105 478 92"></path>
    <path d="M384 250 C 430 250 435 252 478 254"></path>
    <path d="M382 278 C 430 305 430 400 478 414"></path>
  </g>
  <!-- data packets -->
  <g fill="var(--color-mint-400)">
    <circle cx="196" cy="90" r="3.5"></circle>
    <circle cx="186" cy="230" r="3.5"></circle>
    <circle cx="200" cy="392" r="3.5"></circle>
    <circle cx="432" cy="140" r="3.5"></circle>
    <circle cx="428" cy="251" r="3.5"></circle>
    <circle cx="434" cy="368" r="3.5"></circle>
  </g>

  <!-- source cards -->
  <g>
    {
      [
        { y: 34, label: 'ATS' },
        { y: 122, label: 'CRM' },
        { y: 210, label: 'Email' },
        { y: 298, label: 'Calls' },
        { y: 386, label: 'Sheets' },
      ].map((s) => (
        <g>
          <rect x="8" y={s.y} width="118" height="64" rx="10" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.15" stroke-width="1.5" />
          <circle cx="32" cy={s.y + 24} r="9" fill="var(--color-mint-400)" opacity="0.25" />
          <circle cx="32" cy={s.y + 24} r="9" stroke="var(--color-navy-800)" stroke-opacity="0.6" stroke-width="1.5" />
          <text x="50" y={s.y + 29} font-family="var(--font-mono)" font-size="12" font-weight="600" fill="var(--color-navy-800)">
            {s.label}
          </text>
          <rect x="24" y={s.y + 42} width="86" height="5" rx="2.5" fill="var(--color-navy-800)" opacity="0.1" />
          <rect x="24" y={s.y + 51} width="58" height="5" rx="2.5" fill="var(--color-navy-800)" opacity="0.1" />
        </g>
      ))
    }
  </g>

  <!-- floating source chips -->
  <g font-family="var(--font-mono)" font-size="10">
    <rect x="140" y="20" width="46" height="20" rx="10" fill="var(--color-lavender-300)" opacity="0.35"></rect>
    <text x="163" y="33" text-anchor="middle" fill="var(--color-navy-800)">CVs</text>
    <rect x="146" y="460" width="58" height="20" rx="10" fill="var(--color-sky-300)" opacity="0.4"></rect>
    <text x="175" y="473" text-anchor="middle" fill="var(--color-navy-800)">Notes</text>
  </g>

  <!-- central database cylinder -->
  <g>
    <path d="M258 205 v100 c0 10.5 27.8 19 62 19 s62 -8.5 62 -19 v-100" fill="white"></path>
    <path
      d="M258 205 v100 c0 10.5 27.8 19 62 19 s62 -8.5 62 -19 v-100"
      stroke="var(--color-navy-800)"
      stroke-width="1.75"
    ></path>
    <ellipse cx="320" cy="205" rx="62" ry="19" fill="var(--color-mint-400)" opacity="0.25"></ellipse>
    <ellipse cx="320" cy="205" rx="62" ry="19" fill="white" fill-opacity="0.6" stroke="var(--color-navy-800)" stroke-width="1.75"></ellipse>
    <path d="M258 240 c0 10.5 27.8 19 62 19 s62 -8.5 62 -19" stroke="var(--color-navy-800)" stroke-opacity="0.35" stroke-width="1.5"></path>
    <path d="M258 272 c0 10.5 27.8 19 62 19 s62 -8.5 62 -19" stroke="var(--color-navy-800)" stroke-opacity="0.35" stroke-width="1.5"></path>
    <!-- spark -->
    <path
      d="M320 190 l3.2 9.6 9.6 3.2 -9.6 3.2 -3.2 9.6 -3.2 -9.6 -9.6 -3.2 9.6 -3.2Z"
      fill="var(--color-mint-400)"
      opacity="0.9"
      transform="translate(0,-2)"
    ></path>
    <text
      x="320"
      y="352"
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size="11"
      letter-spacing="1.5"
      font-weight="600"
      fill="var(--color-mint-700)"
    >AI TALENT MEMORY</text>
  </g>

  <!-- output: shortlist -->
  <g>
    <rect x="478" y="40" width="154" height="104" rx="12" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.15" stroke-width="1.5"></rect>
    <text x="492" y="62" font-family="var(--font-mono)" font-size="10" letter-spacing="1" fill="var(--color-navy-800)" opacity="0.6">SHORTLIST</text>
    {
      [0, 1, 2].map((i) => (
        <g>
          <circle cx="500" cy={80 + i * 20} r="6" fill="var(--color-sky-300)" opacity={1 - i * 0.25} />
          <rect x="514" y={76 + i * 20} width={58 - i * 8} height="7" rx="3.5" fill="var(--color-navy-800)" opacity="0.15" />
          <rect x="590" y={75 + i * 20} width="30" height="10" rx="5" fill="var(--color-mint-400)" opacity={0.5 - i * 0.12} />
        </g>
      ))
    }
  </g>

  <!-- output: why it matches -->
  <g>
    <rect x="478" y="202" width="154" height="104" rx="12" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.15" stroke-width="1.5"></rect>
    <text x="492" y="224" font-family="var(--font-mono)" font-size="10" letter-spacing="1" fill="var(--color-navy-800)" opacity="0.6">WHY IT MATCHES</text>
    {
      [0, 1, 2].map((i) => (
        <g>
          <path
            d={`m492 ${238 + i * 20} 3.5 3.5 6 -6`}
            stroke="var(--color-mint-700)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <rect x="510" y={234 + i * 20} width={106 - i * 22} height="7" rx="3.5" fill="var(--color-navy-800)" opacity="0.15" />
        </g>
      ))
    }
  </g>

  <!-- output: outreach draft -->
  <g>
    <rect x="478" y="364" width="154" height="104" rx="12" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.15" stroke-width="1.5"></rect>
    <text x="492" y="386" font-family="var(--font-mono)" font-size="10" letter-spacing="1" fill="var(--color-navy-800)" opacity="0.6">OUTREACH DRAFT</text>
    <rect x="492" y="396" width="124" height="7" rx="3.5" fill="var(--color-navy-800)" opacity="0.15"></rect>
    <rect x="492" y="409" width="98" height="7" rx="3.5" fill="var(--color-navy-800)" opacity="0.15"></rect>
    <rect x="492" y="422" width="112" height="7" rx="3.5" fill="var(--color-navy-800)" opacity="0.15"></rect>
    <rect x="492" y="440" width="52" height="18" rx="9" fill="var(--color-mint-400)" opacity="0.9"></rect>
    <text x="518" y="452" text-anchor="middle" font-family="var(--font-mono)" font-size="9" font-weight="600" fill="var(--color-navy-900)">SEND</text>
  </g>
</svg>
