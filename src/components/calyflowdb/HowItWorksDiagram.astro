---
/**
 * Three-step product diagram: connect sources → enrich profiles →
 * agents search, match and explain.
 */
---

<svg
  viewBox="0 0 880 300"
  fill="none"
  role="img"
  aria-label="Three-step diagram: connect your recruiting tools, enrich candidate profiles, then let AI agents search and match"
  class="h-auto w-full"
>
  <defs>
    <linearGradient id="hiw-glow" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="var(--color-mint-400)"></stop>
      <stop offset="100%" stop-color="var(--color-sky-300)"></stop>
    </linearGradient>
  </defs>

  <!-- connecting arrows -->
  <g stroke="var(--color-navy-800)" stroke-opacity="0.25" stroke-width="1.5">
    <path d="M268 140 h84" stroke-dasharray="5 5"></path>
    <path d="M612 140 h84" stroke-dasharray="5 5"></path>
  </g>
  <path d="m346 140-6-4.5v9Z" fill="var(--color-navy-800)" opacity="0.4"></path>
  <path d="m690 140-6-4.5v9Z" fill="var(--color-navy-800)" opacity="0.4"></path>
  <circle cx="310" cy="140" r="3.5" fill="var(--color-mint-400)"></circle>
  <circle cx="654" cy="140" r="3.5" fill="var(--color-mint-400)"></circle>

  <!-- STEP 1: connect -->
  <g>
    <rect x="40" y="48" width="228" height="184" rx="8" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.14" stroke-width="1.5"></rect>
    <circle cx="64" cy="72" r="13" fill="var(--color-mint-400)" opacity="0.25"></circle>
    <text x="64" y="77" text-anchor="middle" font-family="var(--font-mono)" font-size="12" font-weight="700" fill="var(--color-mint-700)">1</text>
    <text x="88" y="77" font-family="var(--font-display)" font-size="14" font-weight="600" fill="var(--color-navy-900)">Connect</text>
    {
      ['ATS', 'CRM', 'Email', 'Calls', 'Sheets', 'Slack'].map((label, i) => {
        const x = 60 + (i % 3) * 66;
        const y = 100 + Math.floor(i / 3) * 56;
        return (
          <g>
            <rect x={x} y={y} width="56" height="44" rx="6" fill="var(--color-cream-50)" stroke="var(--color-navy-800)" stroke-opacity="0.16" stroke-width="1.5" />
            <circle cx={x + 28} cy={y + 16} r="6" fill={i % 2 ? 'var(--color-sky-300)' : 'var(--color-mint-400)'} opacity="0.5" />
            <text x={x + 28} y={y + 36} text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-navy-800)" opacity="0.75">
              {label}
            </text>
          </g>
        );
      })
    }
    <text x="154" y="262" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.5" fill="var(--color-navy-800)" opacity="0.55">YOUR EXISTING STACK</text>
  </g>

  <!-- STEP 2: enrich -->
  <g>
    <rect x="384" y="48" width="228" height="184" rx="8" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.14" stroke-width="1.5"></rect>
    <circle cx="408" cy="72" r="13" fill="var(--color-mint-400)" opacity="0.25"></circle>
    <text x="408" y="77" text-anchor="middle" font-family="var(--font-mono)" font-size="12" font-weight="700" fill="var(--color-mint-700)">2</text>
    <text x="432" y="77" font-family="var(--font-display)" font-size="14" font-weight="600" fill="var(--color-navy-900)">Enrich</text>

    <!-- messy lines in -->
    <g stroke="var(--color-navy-800)" stroke-opacity="0.25" stroke-width="1.5" stroke-linecap="round">
      <path d="M404 120 q10 6 22 2"></path>
      <path d="M402 146 q14 -6 24 0"></path>
      <path d="M404 172 q10 8 22 -2"></path>
    </g>
    <!-- processor -->
    <rect x="446" y="104" width="88" height="88" rx="8" fill="url(#hiw-glow)" opacity="0.22"></rect>
    <rect x="446" y="104" width="88" height="88" rx="8" stroke="var(--color-navy-800)" stroke-width="1.75"></rect>
    <path
      d="M490 122 l4.5 13.5 13.5 4.5 -13.5 4.5 -4.5 13.5 -4.5 -13.5 -13.5 -4.5 13.5 -4.5Z"
      fill="var(--color-mint-400)"
    ></path>
    <path d="M517 116 v8 M521 120 h-8" stroke="var(--color-navy-800)" stroke-opacity="0.5" stroke-width="1.5" stroke-linecap="round"></path>
    <!-- structured lines out -->
    <g stroke="var(--color-mint-700)" stroke-width="2" stroke-linecap="round">
      <path d="M552 122 h28"></path>
      <path d="M552 148 h28"></path>
      <path d="M552 174 h28"></path>
    </g>
    <text x="498" y="262" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.5" fill="var(--color-navy-800)" opacity="0.55">ENRICHED PROFILES</text>
  </g>

  <!-- STEP 3: agents -->
  <g>
    <rect x="728" y="48" width="228" height="184" rx="8" fill="white" stroke="var(--color-navy-800)" stroke-opacity="0.14" stroke-width="1.5" transform="translate(-88 0)"></rect>
    <circle cx="664" cy="72" r="13" fill="var(--color-mint-400)" opacity="0.25"></circle>
    <text x="664" y="77" text-anchor="middle" font-family="var(--font-mono)" font-size="12" font-weight="700" fill="var(--color-mint-700)">3</text>
    <text x="688" y="77" font-family="var(--font-display)" font-size="14" font-weight="600" fill="var(--color-navy-900)">Search &amp; match</text>

    <!-- agent node -->
    <circle cx="700" cy="130" r="20" fill="var(--color-lavender-300)" opacity="0.35"></circle>
    <circle cx="700" cy="130" r="20" stroke="var(--color-navy-800)" stroke-width="1.75"></circle>
    <circle cx="693" cy="127" r="2.25" fill="var(--color-navy-800)"></circle>
    <circle cx="707" cy="127" r="2.25" fill="var(--color-navy-800)"></circle>
    <path d="M693 137 q7 5 14 0" stroke="var(--color-navy-800)" stroke-width="1.75" stroke-linecap="round"></path>
    <path d="M700 110 v-8 m0 0 h6" stroke="var(--color-navy-800)" stroke-width="1.75" stroke-linecap="round"></path>

    <!-- shortlist output -->
    <rect x="742" y="104" width="98" height="88" rx="6" fill="var(--color-cream-50)" stroke="var(--color-navy-800)" stroke-opacity="0.18" stroke-width="1.5"></rect>
    {
      [0, 1, 2].map((i) => (
        <g>
          <path
            d={`m754 ${122 + i * 22} 3 3 5.5 -5.5`}
            stroke="var(--color-mint-700)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <rect x="770" y={118 + i * 22} width={56 - i * 10} height="7" rx="3.5" fill="var(--color-navy-800)" opacity="0.18" />
        </g>
      ))
    }
    <path d="M722 124 h16 m-16 12 h16" stroke="var(--color-navy-800)" stroke-opacity="0.3" stroke-width="1.5" stroke-linecap="round"></path>
    <text x="754" y="262" text-anchor="middle" font-family="var(--font-mono)" font-size="10" letter-spacing="1.5" fill="var(--color-navy-800)" opacity="0.55">EVIDENCE-BACKED</text>
  </g>
</svg>
