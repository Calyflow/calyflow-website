---
import { SITE } from '../data/site';
import Button from './Button.astro';
import Logo from './Logo.astro';

const nav = [
  { label: 'How it works', href: '/#how-it-works' },
  { label: 'Open source', href: '/#open-source' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 z-40 border-b border-navy-800/10 bg-cream-50/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" aria-label="Calyflow home"><Logo /></a>

    <nav aria-label="Main" class="hidden items-center gap-7 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[0.9375rem] font-medium text-navy-800/80 transition-colors hover:text-navy-900"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <Button href={SITE.signupUrl} event="cta-header">Create free account</Button>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-[10px] text-navy-800 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-navy-800/10 px-5 pt-3 pb-5 md:hidden">
    <ul class="flex flex-col gap-1">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="block rounded-[10px] px-3 py-2.5 font-medium text-navy-800 hover:bg-cream-100">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-3 px-3">
      <Button href={SITE.signupUrl} event="cta-mobile-nav" class="w-full">Create free account</Button>
    </div>
  </nav>
</header>

<script>
  // The site's only interactive island: the mobile nav toggle.
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });
  // Close the menu when a link inside it is chosen (e.g. anchor links).
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.querySelector('.icon-open')?.classList.remove('hidden');
      toggle?.querySelector('.icon-close')?.classList.add('hidden');
    }
  });
</script>
