---
import { SITE } from '../data/site';
import Button from './Button.astro';
import Logo from './Logo.astro';

const howItWorks = [
  { label: 'Demo', href: '/demo' },
  { label: 'Agents', href: '/automation-library' },
  { label: 'Automation Hub', href: '/automation-hub' },
  { label: 'ATS / CRM Enrichment', href: '/ats-crm-enrichment' },
];

// `dropdown` renders as a hover/focus submenu on desktop and a grouped
// section in the mobile menu.
const nav = [
  { label: 'Home', href: '/' },
  { label: 'CalyflowDB', href: '/calyflowdb' },
  { label: 'How it works', dropdown: howItWorks },
  { label: 'Docs', href: SITE.docsUrl, external: true },
  { label: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 z-40 border-b border-navy-800/10 bg-cream-50/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" aria-label="Calyflow home"><Logo /></a>

    <nav aria-label="Main" class="hidden items-center gap-7 md:flex">
      {
        nav.map((item) =>
          item.dropdown ? (
            <div class="group relative">
              <button
                type="button"
                class="inline-flex items-center gap-1 py-5 text-sm font-medium text-navy-800/80 transition-colors group-focus-within:text-navy-900 group-hover:text-navy-900"
                aria-haspopup="true"
              >
                {item.label}
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="opacity-50 transition-transform duration-200 group-focus-within:rotate-180 group-hover:rotate-180"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
              <div class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 pt-1 opacity-0 transition duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <ul class="min-w-56 rounded-card border border-navy-800/10 bg-cream-50 p-2 shadow-lg shadow-navy-900/8">
                  {item.dropdown.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        class="block rounded-chip px-3.5 py-2.5 text-sm font-medium text-navy-800/80 hover:bg-cream-100 hover:text-navy-900"
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              rel={item.external ? 'noopener' : undefined}
              class="inline-flex items-center gap-1 text-sm font-medium text-navy-800/80 transition-colors hover:text-navy-900"
            >
              {item.label}
              {item.external && (
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="opacity-50"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              )}
            </a>
          )
        )
      }
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a
        href={SITE.loginUrl}
        data-event="login-header"
        class="text-sm font-medium text-navy-800/80 transition-colors hover:text-navy-900"
      >
        Log in
      </a>
      <Button href={SITE.signupUrl} size="sm" event="cta-header">Create free account</Button>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-chip text-navy-800 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden border-t border-navy-800/10 px-5 pt-3 pb-5 md:hidden">
    <ul class="flex flex-col gap-1">
      {
        nav.map((item) =>
          item.dropdown ? (
            <li>
              <p class="px-3 pt-3 pb-1 font-mono text-xs font-medium tracking-wide text-navy-800/50 uppercase">
                {item.label}
              </p>
              <ul class="flex flex-col gap-1">
                {item.dropdown.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class="flex items-center gap-1.5 rounded-chip px-3 py-2.5 pl-6 font-medium text-navy-800 hover:bg-cream-100"
                    >
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                rel={item.external ? 'noopener' : undefined}
                class="flex items-center gap-1.5 rounded-chip px-3 py-2.5 font-medium text-navy-800 hover:bg-cream-100"
              >
                {item.label}
                {item.external && (
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="opacity-50"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                )}
              </a>
            </li>
          )
        )
      }
    </ul>
    <div class="mt-3 flex flex-col gap-2 px-3">
      <Button href={SITE.signupUrl} event="cta-mobile-nav" class="w-full">Create free account</Button>
      <Button href={SITE.loginUrl} variant="secondary" event="login-mobile-nav" class="w-full">Log in</Button>
    </div>
  </nav>
</header>

<script>
  // The site's only interactive island: the mobile nav toggle.
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });
  // Close the menu when a link inside it is chosen (e.g. anchor links).
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.querySelector('.icon-open')?.classList.remove('hidden');
      toggle?.querySelector('.icon-close')?.classList.add('hidden');
    }
  });
</script>
