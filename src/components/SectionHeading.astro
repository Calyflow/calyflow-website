---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  class?: string;
  /** Heading level — use "h1" when this is the page's top heading. */
  as?: 'h1' | 'h2';
}

const { eyebrow, title, id, class: className, as: Heading = 'h2' } = Astro.props;
---

<div class:list={['mx-auto max-w-2xl text-center', className]}>
  {
    eyebrow && (
      <p class="mb-3 font-mono text-sm font-medium tracking-wide text-mint-700 uppercase">
        {eyebrow}
      </p>
    )
  }
  <Heading {id} class="text-3xl tracking-tight md:text-4xl">{title}</Heading>
  {
    Astro.slots.has('default') && (
      <p class="mt-4 text-navy-800/55">
        <slot />
      </p>
    )
  }
</div>
