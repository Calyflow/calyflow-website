---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  class?: string;
  /** data-event name for analytics (conversion tracking per section). */
  event?: string;
}

const { href, variant = 'primary', size = 'md', class: className, event } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-chip font-semibold transition duration-200 ease-out hover:-translate-y-0.5 motion-reduce:hover:translate-y-0 focus-ring';
const variants = {
  primary: 'bg-mint-400 text-navy-800 hover:brightness-105',
  secondary:
    'border-[1.5px] border-navy-800/25 text-navy-800 hover:border-navy-800 bg-transparent',
};
const sizes = {
  md: 'px-5 py-2.5 text-[0.9375rem]',
  lg: 'px-7 py-3.5 text-base',
};
---

<a href={href} class:list={[base, variants[variant], sizes[size], className]} data-event={event}>
  <slot />
</a>
