---
import { SITE } from '../data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<!-- The one dark section, bookending the page (DESIGN.md §7) -->
<footer class="bg-navy-900 text-cream-50">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a href="/" aria-label="Calyflow home"><Logo onDark /></a>
        <p class="mt-4 text-[0.9375rem] leading-relaxed text-cream-50/65">
          {SITE.definition}
        </p>
        <p class="mt-4 font-mono text-xs text-cream-50/45">
          Open source · {SITE.productLicense} · Built in the EU
        </p>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <h2 class="font-display text-sm font-semibold tracking-wide text-cream-50/50 uppercase">Product</h2>
          <ul class="mt-3 space-y-2 text-[0.9375rem]">
            <li><a href="/automation-library" class="text-cream-50/80 hover:text-cream-50">Workflows &amp; Agents</a></li>
            <li><a href="/#principles" class="text-cream-50/80 hover:text-cream-50">Bring your own</a></li>
            <li><a href="/#faq" class="text-cream-50/80 hover:text-cream-50">FAQ</a></li>
            <li><a href={SITE.signupUrl} class="text-cream-50/80 hover:text-cream-50">Create free account</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-display text-sm font-semibold tracking-wide text-cream-50/50 uppercase">Resources</h2>
          <ul class="mt-3 space-y-2 text-[0.9375rem]">
            <li><a href="/blog" class="text-cream-50/80 hover:text-cream-50">Blog</a></li>
            <li><a href="/rss.xml" class="text-cream-50/80 hover:text-cream-50">RSS</a></li>
            <li><a href={SITE.githubUrl} rel="noopener" class="text-cream-50/80 hover:text-cream-50">GitHub</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-display text-sm font-semibold tracking-wide text-cream-50/50 uppercase">Company</h2>
          <ul class="mt-3 space-y-2 text-[0.9375rem]">
            <li><a href="/privacy" class="text-cream-50/80 hover:text-cream-50">Privacy</a></li>
            <li><a href={`mailto:${SITE.contactEmail}`} class="text-cream-50/80 hover:text-cream-50">Contact</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <p class="mt-12 border-t border-cream-50/10 pt-6 font-mono text-xs text-cream-50/45">
      © {year} Calyflow · {SITE.tagline}
    </p>
  </div>
</footer>
