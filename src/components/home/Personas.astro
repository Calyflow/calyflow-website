---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import SectionHeading from '../SectionHeading.astro';

const personas = [
  {
    title: 'Independent Recruiter',
    points: ['Sourcing on autopilot', 'Personalized outreach at scale', 'Candidate research in minutes'],
    offer: 'Free forever with your own AI key',
    featured: false,
  },
  {
    title: 'Recruiting Agency',
    points: ['Shared workflows for the whole desk', 'Team collaboration on every search', 'Reporting clients actually read'],
    offer: 'Free for 30 days',
    featured: true,
  },
  {
    title: 'Enterprise Talent Team',
    points: ['Governance and permissions', 'Private deployment on your GCP, deployed by us', 'Audit-ready AI usage'],
    offer: 'Free for 30 days · self-host option',
    featured: false,
  },
];
---

<section class="bg-cream-100 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading eyebrow="Who it's for" title="From solo desk to enterprise team" />

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        personas.map((p) => (
          <div
            class:list={[
              'flex flex-col rounded-[20px] bg-white p-8',
              p.featured
                ? 'border-2 border-mint-400 shadow-[0_8px_30px_rgba(19,31,56,0.08)]'
                : 'border border-navy-800/12',
            ]}
          >
            <h3 class="font-display text-2xl font-semibold">{p.title}</h3>
            <ul class="mt-5 flex-1 space-y-3">
              {p.points.map((point) => (
                <li class="flex items-start gap-2.5 text-[0.9375rem] text-navy-800/75">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-mint-700)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true">
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
            <p class="mt-6 font-mono text-sm text-mint-700">{p.offer}</p>
            <Button href={SITE.signupUrl} event={`cta-persona-${p.title.toLowerCase().replace(/\s+/g, '-')}`} class="mt-4 w-full">
              Create free account
            </Button>
            {p.title === 'Enterprise Talent Team' && (
              <a href={`mailto:${SITE.contactEmail}?subject=Private%20deployment`} class="mt-3 text-center text-sm font-medium text-mint-700 hover:underline">
                Talk to us about private deployment
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
