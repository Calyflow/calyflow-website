---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import GitHubButton from '../GitHubButton.astro';
---

<section class="relative overflow-hidden">
  <!-- Aurora glow: mint → sky, atmospheric, never structural -->
  <div class="aurora-glow absolute -top-40 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pt-20 pb-16 text-center md:pt-28 md:pb-20">
    <h1 class="mx-auto max-w-3xl font-display text-[clamp(2.5rem,6vw,3.75rem)] leading-[1.05] font-bold tracking-[-0.01em] text-balance">
      Open-source <span class="text-gradient-brand">Recruiting Agents</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-xl text-navy-800/70">
      Run AI-powered sourcing, screening, and outreach workflows on your own AI, your own data,
      your own tools.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href={SITE.signupUrl} size="lg" event="cta-hero">Create free account</Button>
      <Button href={SITE.loginUrl} variant="secondary" size="lg" event="login-hero">Log in</Button>
      <GitHubButton size="lg" event="github-click-hero" />
    </div>
    <p class="mt-4 font-mono text-sm text-navy-800/55">
      Free to start · $10 AI credit included · No credit card
    </p>

    <div class="mt-14">
      <img
        src="/hero-dashboard.svg"
        alt="Calyflow workspace for a Senior DevOps search: readiness chips show the job description and intake notes are attached with three CVs; workflow cards show CV Screener running, Sourcing Map completed and Outreach Writer ready; a screening report streams in with evidence-quoted must-haves, a flagged gap to ask about, and the run cost in the footer."
        width="1200"
        height="780"
        class="mx-auto w-full max-w-5xl rounded-panel ring-1 ring-navy-900/10 shadow-[0_2px_6px_rgba(19,31,56,0.06),0_24px_56px_-12px_rgba(19,31,56,0.28)]"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
