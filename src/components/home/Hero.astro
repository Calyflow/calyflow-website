---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import GitHubButton from '../GitHubButton.astro';
---

<section class="relative overflow-hidden">
  <!-- Aurora glow: mint → sky, atmospheric, never structural -->
  <div class="aurora-glow absolute -top-40 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pt-16 pb-12 text-center md:pt-20 md:pb-16">
    <h1 class="mx-auto max-w-3xl font-display text-[clamp(2.5rem,6vw,3.75rem)] leading-[1.05] font-bold tracking-[-0.01em] text-balance">
      Agentic Recruiting
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-xl text-navy-800/70">
      Fully autonomous agents. Upload a job description, add your unpublished insights, and they
      connect to your databases, LinkedIn Proxy, and 30+ data providers, then start sourcing.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href={SITE.signupUrl} size="lg" event="cta-hero">Create free account</Button>
      <GitHubButton size="lg" event="github-click-hero" />
    </div>
    <p class="mt-4 font-mono text-sm text-navy-800/70">
      Free to start · $10 AI credit included · No credit card
    </p>

    <div class="mt-14">
      <img
        src="/hero-shortlist.svg"
        alt="Calyflow project Shortlist for a Tech Lead search: AI-ranked candidates with source badges, FIT status, and fit scores; the Shortlist tab is active under Documents, Sourcing, Outreach, Files, and Activity."
        width="1200"
        height="780"
        class="mx-auto w-full max-w-5xl rounded-panel ring-1 ring-navy-900/10 shadow-[0_2px_6px_rgba(19,31,56,0.06),0_24px_56px_-12px_rgba(19,31,56,0.28)]"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
