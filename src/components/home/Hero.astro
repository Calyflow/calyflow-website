---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import GitHubButton from '../GitHubButton.astro';
---

<section class="relative overflow-hidden">
  <!-- Aurora glow: mint → sky, atmospheric, never structural -->
  <div class="aurora-glow absolute -top-40 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pt-20 pb-16 text-center md:pt-28 md:pb-20">
    <h1 class="mx-auto max-w-3xl font-display text-[clamp(2.75rem,6vw,3.75rem)] leading-[1.05] font-bold tracking-[-0.01em]">
      Open-source <span class="text-gradient-brand">Recruiting&nbsp;OS</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-xl text-navy-800/70">
      Run AI-powered recruiting workflows — sourcing, screening, outreach — on your own AI, your
      own data, your own tools.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href={SITE.signupUrl} size="lg" event="cta-hero">Create free account</Button>
      <GitHubButton size="lg" event="github-click-hero" />
    </div>
    <p class="mt-4 font-mono text-sm text-navy-800/55">
      Free to start · Your own API key · No credit card
    </p>

    <div class="mt-14">
      <img
        src="/hero-dashboard.svg"
        alt="Calyflow workspace: a recruiter's active project with readiness chips for the job description, intake notes and three CVs; workflow cards for CV Screener (running), Sourcing Map (completed) and Outreach Writer (ready); and a screening report streaming in with evidence-quoted must-haves and the run cost."
        width="1080"
        height="680"
        class="mx-auto w-full max-w-5xl rounded-[20px] border border-navy-800/12 bg-white shadow-[0_8px_30px_rgba(19,31,56,0.08)]"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
