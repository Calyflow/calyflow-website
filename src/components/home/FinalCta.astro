---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
---

<section class="relative overflow-hidden py-24 md:py-32">
  <div class="aurora-glow cta-aurora absolute top-1/2 left-1/2 h-[360px] w-[640px] -translate-x-1/2 -translate-y-1/2 rounded-full" aria-hidden="true"></div>

  <!-- twinkling sparks -->
  <svg class="cta-spark absolute top-[22%] left-[16%] hidden md:block" width="26" height="26" viewBox="0 0 24 24" fill="var(--color-mint-400)" aria-hidden="true">
    <path d="M12 2.5 14 9.5 21 12 14 14.5 12 21.5 10 14.5 3 12 10 9.5Z"></path>
  </svg>
  <svg class="cta-spark cta-spark-2 absolute right-[18%] bottom-[24%] hidden md:block" width="18" height="18" viewBox="0 0 24 24" fill="var(--color-sky-300)" aria-hidden="true">
    <path d="M12 2.5 14 9.5 21 12 14 14.5 12 21.5 10 14.5 3 12 10 9.5Z"></path>
  </svg>
  <svg class="cta-spark cta-spark-3 absolute top-[30%] right-[26%] hidden md:block" width="13" height="13" viewBox="0 0 24 24" fill="var(--color-lavender-300)" aria-hidden="true">
    <path d="M12 2.5 14 9.5 21 12 14 14.5 12 21.5 10 14.5 3 12 10 9.5Z"></path>
  </svg>

  <div class="relative mx-auto max-w-2xl px-5 text-center">
    <h2 class="text-3xl tracking-tight md:text-4xl">Stop chatting. Start running workflows.</h2>
    <p class="mt-4 text-xl text-navy-800/70">
      Free to start. Your own API key. No credit card.
    </p>
    <div class="mt-8">
      <Button href={SITE.signupUrl} size="lg" event="cta-final">Create free account</Button>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .cta-aurora {
      animation: cta-aurora-drift 12s ease-in-out infinite;
    }
    .cta-spark {
      animation: cta-twinkle 4s ease-in-out infinite;
    }
    .cta-spark-2 {
      animation-delay: 1.3s;
      animation-duration: 5s;
    }
    .cta-spark-3 {
      animation-delay: 2.6s;
      animation-duration: 4.5s;
    }
  }
  @keyframes cta-aurora-drift {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
    50% {
      transform: translate(-46%, -52%) scale(1.1);
      opacity: 0.85;
    }
  }
  @keyframes cta-twinkle {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.8) rotate(0deg);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.15) rotate(20deg);
    }
  }
</style>
