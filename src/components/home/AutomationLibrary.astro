---
import { getLibrary, pickFeatured } from '../../lib/library';
import SectionHeading from '../SectionHeading.astro';
import LibraryCard from '../library/LibraryCard.astro';

const { workflows, agents } = await getLibrary();
const featuredWorkflows = pickFeatured(workflows, 3);
const featuredAgents = pickFeatured(agents, 3);
const total = workflows.length + agents.length;

const groups = [
  {
    key: 'workflows',
    title: 'Workflows',
    blurb:
      'Focused automations. Give one your knowledge base — your company, your team, the client you’re recruiting for — and a skill, a detailed prompt packed with expert instructions, and it returns a finished outcome in seconds.',
    items: featuredWorkflows,
  },
  {
    key: 'agents',
    title: 'Agents',
    blurb:
      'Multi-step and tool-using. Agents think mid-process, decide the best course of action, and work with live data from your ATS, CRM, or sourcing and enrichment tools — then write the result back into your project.',
    items: featuredAgents,
  },
];
---

<section id="automation-library" class="scroll-mt-20 bg-cream-100 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading eyebrow="Automation library" title="An automation platform for recruiting">
      Calyflow runs two kinds of automation on your own AI, data, and tools: workflows that turn a
      brief into a finished deliverable, and agents that reach into your systems to do the work.
    </SectionHeading>

    {
      groups.map((group) => (
        <div class="mt-16 first:mt-14">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="max-w-2xl">
              <h3 class="font-display text-2xl font-semibold text-navy-900">{group.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-navy-800/65">{group.blurb}</p>
            </div>
            <a
              href={`/automation-library#${group.key}`}
              class="shrink-0 font-mono text-sm font-medium text-mint-700 hover:text-navy-900"
              data-event={`library-see-all-${group.key}`}
            >
              See all {group.key} <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="mt-7 grid gap-6 md:grid-cols-3">
            {group.items.map((item) => (
              <LibraryCard item={item} />
            ))}
          </div>
        </div>
      ))
    }

    <p class="mt-14 text-center font-mono text-sm text-navy-800/55">
      <a href="/automation-library" class="text-navy-800/70 hover:text-navy-900">
        {total} workflows and agents available to use
      </a>
    </p>
  </div>
</section>
