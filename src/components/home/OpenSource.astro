---
import { SITE } from '../../data/site';
import GitHubButton from '../GitHubButton.astro';
import Icon from '../icons/Icon.astro';
---

<section id="open-source" class="scroll-mt-20 border-t border-navy-800/10 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-3xl text-center">
      <span class="oss-shield relative mx-auto inline-flex">
        <span class="oss-ring absolute inset-0 rounded-full bg-mint-400/40" aria-hidden="true"></span>
        <Icon name="open-source-shield" size={48} class="relative" />
      </span>
      <h2 class="mt-5 text-3xl tracking-tight md:text-4xl">Open source, on purpose</h2>

      <!-- The quotable definition — keep this phrasing identical everywhere (spec §5.3) -->
      <p class="mt-6 text-xl leading-relaxed text-navy-800/80">
        {SITE.definition}
      </p>

      <p class="mt-5 text-navy-800/65">
        The code is AGPL-3.0 and inspectable: you can read exactly what happens to every CV and
        every prompt. You can self-host the whole platform on your own infrastructure. And because
        your data lives in your systems and your AI runs on your key, there is no hostage-taking:
        leave any time and take everything with you. Contributions welcome.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <GitHubButton size="lg" event="github-click-oss" />
        <span class="font-mono text-sm text-navy-800/55">License: {SITE.productLicense}</span>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .oss-shield {
      animation: oss-bob 5s ease-in-out infinite;
    }
    .oss-ring {
      animation: oss-ring 3.5s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .oss-ring {
      display: none;
    }
  }
  @keyframes oss-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  @keyframes oss-ring {
    0% {
      transform: scale(0.9);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }
</style>
