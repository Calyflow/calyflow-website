---
import { WORKFLOWS } from '../../data/site';
import Icon from '../icons/Icon.astro';
import SectionHeading from '../SectionHeading.astro';
---

<section id="how-it-works" class="scroll-mt-20 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading eyebrow="How it works" title="One search, eight workflows">
      The launch workflows cover a complete search lifecycle, from intake notes to a client-ready
      submission pack. The same flow you’ll see in the app on day one.
    </SectionHeading>

    <ol class="mx-auto mt-14 max-w-3xl">
      {
        WORKFLOWS.map((wf, i) => (
          <li class="relative flex gap-5 sm:gap-7">
            {/* Timeline rail: numbered node + connecting line */}
            <div class="flex flex-col items-center" aria-hidden="true">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-navy-800/15 bg-white font-mono text-sm text-navy-800/70">
                0{i + 1}
              </span>
              {i < WORKFLOWS.length - 1 && <span class="w-px flex-1 bg-navy-800/12" />}
            </div>

            <div class="min-w-0 flex-1 pb-14 last:pb-0">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 pt-1.5">
                <Icon name={wf.icon} size={24} />
                <h3 class="font-display text-xl font-semibold">{wf.name}</h3>
                <span class="rounded-full bg-cream-100 px-2.5 py-0.5 font-mono text-[0.6875rem] leading-4 text-navy-800/60">
                  {wf.stage}
                </span>
              </div>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-navy-800/65">{wf.description}</p>
              <p class="mt-3 font-mono text-xs text-navy-800/55">
                {wf.input} <span class="text-mint-700">→</span> {wf.output}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
