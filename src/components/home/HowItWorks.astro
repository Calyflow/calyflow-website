---
import { WORKFLOWS } from '../../data/site';
import Icon from '../icons/Icon.astro';
import SectionHeading from '../SectionHeading.astro';
---

<section id="how-it-works" class="scroll-mt-20 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading eyebrow="How it works" title="One search, five workflows">
      The five launch workflows cover a complete search lifecycle — from intake notes to a
      client-ready submission pack. The same flow you’ll see in the app on day one.
    </SectionHeading>

    <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {
        WORKFLOWS.map((wf, i) => (
          <li class="group relative flex flex-col rounded-[14px] border border-navy-800/12 bg-white p-6 transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgba(19,31,56,0.08)] motion-reduce:hover:translate-y-0">
            <div class="flex items-center justify-between">
              <Icon name={wf.icon} size={32} />
              <span class="font-mono text-sm text-navy-800/40">0{i + 1}</span>
            </div>
            <h3 class="mt-4 font-display text-xl font-semibold">{wf.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-800/65">{wf.description}</p>
            <p class="mt-4 border-t border-navy-800/10 pt-3 font-mono text-xs text-navy-800/55">
              {wf.input} → {wf.output}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
