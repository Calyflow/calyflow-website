---
/**
 * Problem marquee above "The problem": crossed-out pain points
 * scrolling left. Replaces the old social-proof strip.
 */
const labels = ['Slow sourcing', 'Dependency on LinkedIn', 'Weak search'] as const;

/** Duplicate enough times for a seamless wide-viewport loop. */
const track = [...labels, ...labels, ...labels, ...labels];
---

<section class="problem-marquee border-y border-navy-800/10 bg-cream-100" aria-label="Common recruiting problems">
  <div
    class="problem-marquee__viewport overflow-hidden py-5 [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
  >
    <div class="problem-marquee__track flex w-max items-center gap-10 pr-10" aria-hidden="true">
      {
        track.map((label) => (
          <span class="inline-flex shrink-0 items-center gap-2.5">
            <svg
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              class="shrink-0 text-coral-700"
              aria-hidden="true"
            >
              <path
                d="M3 3l8 8M11 3l-8 8"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
            </svg>
            <span class="relative font-display text-[1.0625rem] font-semibold tracking-[-0.01em] text-navy-800/70">
              {label}
              <span
                class="pointer-events-none absolute top-1/2 right-0 left-0 h-px -translate-y-1/2 bg-coral-700"
                aria-hidden="true"
              />
            </span>
          </span>
        ))
      }
    </div>
    <p class="sr-only">
      Crossed-out problems: {labels.join(', ')}.
    </p>
  </div>
</section>

<style>
  .problem-marquee__track {
    animation: problem-marquee-scroll 28s linear infinite;
  }

  .problem-marquee:hover .problem-marquee__track {
    animation-play-state: paused;
  }

  @keyframes problem-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Four label-set copies → shift by one quarter of the track */
      transform: translateX(-25%);
    }
  }
</style>
