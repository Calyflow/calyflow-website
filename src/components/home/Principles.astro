---
import integrations from '../../data/integrations.json';
import Badge from '../Badge.astro';
import Icon from '../icons/Icon.astro';
import SectionHeading from '../SectionHeading.astro';

interface Integration {
  name: string;
  status: 'available' | 'coming-soon';
}

// The differentiator block (spec §3.4). Logo states come from
// integrations.json — the honesty rule made structural.
const columns: {
  icon: 'key' | 'database' | 'integration-plug';
  title: string;
  blurb: string;
  note?: string;
  items: Integration[];
}[] = [
  {
    icon: 'key',
    title: 'Bring Your Own AI',
    blurb: 'Model-agnostic by design. Use the models you already pay for — switch any time.',
    items: integrations.ai as Integration[],
  },
  {
    icon: 'database',
    title: 'Bring Your Own Data',
    blurb: 'Connect the systems where your candidates already live.',
    note: 'Calyflow does not own your candidate data.',
    items: integrations.data as Integration[],
  },
  {
    icon: 'integration-plug',
    title: 'Bring Your Own Tools',
    blurb: 'Agents can use multiple tools during execution — search, enrich, verify.',
    items: integrations.tools as Integration[],
  },
];
---

<section id="principles" class="scroll-mt-20 bg-cream-100 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading eyebrow="Core principles" title="Your AI. Your data. Your tools.">
      Calyflow is the workflow layer — everything else stays yours. No middleman on your tokens,
      no hostage-taking of your candidate data.
    </SectionHeading>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        columns.map((col) => (
          <div class="rounded-[20px] border border-navy-800/12 bg-white p-7">
            <Icon name={col.icon} size={48} />
            <h3 class="mt-4 font-display text-2xl font-semibold">{col.title}</h3>
            <p class="mt-2 text-[0.9375rem] text-navy-800/65">{col.blurb}</p>
            {col.note && <p class="mt-2 text-[0.9375rem] font-medium text-mint-700">{col.note}</p>}
            <ul class="mt-5 flex flex-wrap gap-2">
              {col.items.map((item) => (
                <li class="inline-flex items-center gap-2 rounded-[10px] border border-navy-800/12 bg-cream-50 py-1.5 pr-1.5 pl-3 text-sm font-medium text-navy-800">
                  {item.name}
                  <Badge status={item.status} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center font-mono text-sm text-navy-800/55">
      Integration states are updated as they ship — never before.
    </p>
  </div>
</section>
