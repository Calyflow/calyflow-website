---
import { getConnectors, type Connector, type ConnectorCategory } from '../../lib/connectors';
import Badge from '../Badge.astro';
import Icon from '../icons/Icon.astro';
import SectionHeading from '../SectionHeading.astro';

// The differentiator block (spec §3.4). Connector states come live from the
// Calyflow app at build time — the honesty rule made structural.
const connectors = await getConnectors();

const columnDefs: {
  icon: 'key' | 'database' | 'integration-plug';
  title: string;
  blurb: string;
  note?: string;
  categories: ConnectorCategory[];
  // Recognizable subset shown as chips; the rest collapse into "+N more".
  // Empty list = show everything in the column.
  featured: string[];
}[] = [
  {
    icon: 'key',
    title: 'Bring Your Own AI',
    blurb: 'Model-agnostic by design. Use the models you already pay for, and switch any time.',
    categories: ['ai'],
    featured: [],
  },
  {
    icon: 'database',
    title: 'Bring Your Own Data',
    blurb: 'Connect the systems where your candidates already live.',
    note: 'Calyflow does not own your candidate data.',
    categories: ['ats', 'crm', 'data'],
    featured: [
      'Greenhouse',
      'Lever',
      'Ashby',
      'Workable',
      'Bullhorn',
      'SmartRecruiters',
      'HubSpot',
      'Notion',
      'Google Sheets',
      'Airtable',
    ],
  },
  {
    icon: 'integration-plug',
    title: 'Bring Your Own Tools',
    blurb: 'Agents can use multiple tools during execution: search, enrich, verify.',
    categories: ['tool'],
    featured: [
      'Apollo',
      'Gong',
      'Hunter.io',
      'Lusha',
      'RocketReach',
      'Fireflies.ai',
      'Bright Data',
      'Instantly.ai',
      'Lemlist',
      'People Data Labs',
    ],
  },
];

const columns = columnDefs.map((col) => {
  const all = connectors.filter((c) => col.categories.includes(c.category));
  const shown =
    col.featured.length > 0
      ? (col.featured
          .map((name) => all.find((c) => c.name === name))
          .filter(Boolean) as Connector[])
      : all;
  return { ...col, items: shown, more: all.length - shown.length };
});
---

<section id="principles" class="scroll-mt-20 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading eyebrow="Core principles" title="Your AI. Your data. Your tools.">
      Calyflow is the workflow layer. Everything else stays yours: no middleman on your tokens,
      no hostage-taking of your candidate data.
    </SectionHeading>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        columns.map((col) => (
          <div class="rounded-panel border border-navy-800/12 bg-white p-7">
            <Icon name={col.icon} size={48} />
            <h3 class="mt-4 font-display text-2xl font-semibold">{col.title}</h3>
            <p class="mt-2 text-[0.9375rem] text-navy-800/65">{col.blurb}</p>
            {col.note && <p class="mt-2 text-[0.9375rem] font-medium text-mint-700">{col.note}</p>}
            <ul class="mt-5 flex flex-wrap gap-2">
              {col.items.map((item) => (
                <li
                  class:list={[
                    'inline-flex items-center gap-2 rounded-chip border border-navy-800/12 bg-cream-50 py-1.5 pl-3 text-sm font-medium text-navy-800',
                    item.status === 'coming-soon' ? 'pr-1.5' : 'pr-3',
                  ]}
                >
                  {item.name}
                  {item.status === 'coming-soon' && <Badge status={item.status} />}
                </li>
              ))}
              {col.more > 0 && (
                <li class="inline-flex items-center rounded-chip border border-navy-800/12 bg-cream-50 px-3 py-1.5 text-sm font-medium text-navy-800/55">
                  +{col.more} more
                </li>
              )}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center font-mono text-sm text-navy-800/55">
      Integration states are updated as they ship, never before.
    </p>
  </div>
</section>
