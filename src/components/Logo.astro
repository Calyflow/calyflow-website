---
interface Props {
  /** Use cream ink on the navy footer. */
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <!-- App icon, matches https://app.calyflow.ai/icon.svg -->
  <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="#FBF7F0"></rect>
    <path
      d="M14 5c1.2 5.9 4.1 8.8 10 10-5.9 1.2-8.8 4.1-10 10-1.2-5.9-4.1-8.8-10-10 5.9-1.2 8.8-4.1 10-10Z"
      fill="#1B7A5F"></path>
    <path
      d="M24.5 19c.4 1.9 1.3 2.8 3.2 3.2-1.9.4-2.8 1.3-3.2 3.2-.4-1.9-1.3-2.8-3.2-3.2 1.9-.4 2.8-1.3 3.2-3.2Z"
      fill="#1B7A5F"></path>
  </svg>
  <span
    class:list={[
      'font-display text-xl font-bold tracking-tight',
      onDark ? 'text-cream-50' : 'text-navy-900',
    ]}>Calyflow</span
  >
</span>
