---
/**
 * Status chip: mint @22% for "available now", amber @22% for "coming soon" —
 * the same visual language as the product UI and hero SVG (DESIGN.md §7).
 */
interface Props {
  status: 'available' | 'coming-soon';
  class?: string;
}

const { status, class: className } = Astro.props;
const isAvailable = status === 'available';
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-full px-2 py-0.5 font-mono text-[0.6875rem] leading-4',
    isAvailable ? 'bg-mint-400/22 text-mint-700' : 'bg-amber-400/22 text-navy-800/70',
    className,
  ]}
>
  {isAvailable ? '✓ Available now' : 'Coming soon'}
</span>
