---
/**
 * Status chip: opaque mint-100 / amber-100 fills with matching -700 ink —
 * same language as the product UI (no alpha washes, no rounded-full pills).
 */
interface Props {
  status: 'available' | 'coming-soon';
  class?: string;
}

const { status, class: className } = Astro.props;
const isAvailable = status === 'available';
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-chip px-2 py-0.5 font-mono text-[0.6875rem] leading-4',
    isAvailable ? 'bg-mint-100 text-mint-700' : 'bg-amber-100 text-amber-700',
    className,
  ]}
>
  {isAvailable ? '✓ Available now' : 'Coming soon'}
</span>
