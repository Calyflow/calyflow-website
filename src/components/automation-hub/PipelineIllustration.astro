---
/**
 * Animated pipeline for "How it works": a data packet travels along the
 * track, lighting up each of the four step nodes as it passes.
 * CSS-only motion, disabled under prefers-reduced-motion.
 */
const nodes = [110, 340, 570, 800];
---

<svg
  viewBox="0 0 880 130"
  fill="none"
  role="img"
  aria-label="A run travelling through four stages: connect, customize, schedule, monitor"
  class="h-auto w-full"
>
  <!-- track -->
  <line x1="110" y1="58" x2="800" y2="58" stroke="var(--color-navy-800)" stroke-opacity="0.14" stroke-width="1.5"></line>
  <line x1="110" y1="58" x2="800" y2="58" stroke="var(--color-mint-400)" stroke-width="2" class="pipe-progress"></line>

  <!-- travelling packet -->
  <g class="pipe-packet">
    <circle cy="58" r="7" fill="var(--color-mint-400)"></circle>
    <circle cy="58" r="7" stroke="var(--color-navy-800)" stroke-opacity="0.5" stroke-width="1.5"></circle>
  </g>

  {
    nodes.map((x, i) => (
      <g>
        <circle cx={x} cy="58" r="17" fill="var(--color-mint-400)" class={`pipe-node-fill pipe-stage-${i}`} />
        <circle cx={x} cy="58" r="17" fill="white" fill-opacity="0.75" stroke="var(--color-navy-800)" stroke-width="1.75" />
        <circle cx={x} cy="58" r="17" stroke="var(--color-mint-700)" stroke-width="2" class={`pipe-node-ring pipe-stage-${i}`} />
        <text
          x={x}
          y="63"
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="12"
          font-weight="700"
          fill="var(--color-navy-800)"
        >
          {`0${i + 1}`}
        </text>
        <text
          x={x}
          y="106"
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="10"
          letter-spacing="1.5"
          fill="var(--color-navy-800)"
          opacity="0.55"
        >
          {['CONNECT', 'CUSTOMIZE', 'SCHEDULE', 'MONITOR'][i]}
        </text>
      </g>
    ))
  }

  <!-- checkmark that pops at the end of each cycle -->
  <g class="pipe-done">
    <circle cx="842" cy="58" r="13" fill="var(--color-mint-400)"></circle>
    <path d="m836 58 4.5 4.5 8-8" stroke="var(--color-navy-900)" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"></path>
  </g>
</svg>

<style>
  .pipe-packet,
  .pipe-node-ring,
  .pipe-node-fill,
  .pipe-progress,
  .pipe-done {
    transform-box: fill-box;
    transform-origin: center;
  }
  .pipe-node-ring,
  .pipe-node-fill {
    opacity: 0;
  }
  .pipe-progress {
    stroke-dasharray: 690;
    stroke-dashoffset: 690;
  }
  .pipe-done {
    opacity: 0;
  }

  /* Static fallback: show everything lit. */
  @media (prefers-reduced-motion: reduce) {
    .pipe-packet {
      transform: translateX(800px);
      display: none;
    }
    .pipe-progress {
      stroke-dashoffset: 0;
    }
    .pipe-node-ring {
      opacity: 1;
    }
    .pipe-done {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pipe-packet {
      animation: pipe-travel 8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
    .pipe-progress {
      animation: pipe-draw 8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
    .pipe-node-ring,
    .pipe-node-fill {
      animation: pipe-node 8s ease-out infinite;
    }
    .pipe-node-fill {
      animation-name: pipe-node-soft;
    }
    .pipe-stage-0 {
      animation-delay: 0s;
    }
    .pipe-stage-1 {
      animation-delay: 1.9s;
    }
    .pipe-stage-2 {
      animation-delay: 3.8s;
    }
    .pipe-stage-3 {
      animation-delay: 5.7s;
    }
    .pipe-done {
      animation: pipe-pop 8s ease-out infinite;
    }
  }

  @keyframes pipe-travel {
    0% {
      transform: translateX(110px);
    }
    82%,
    100% {
      transform: translateX(800px);
    }
  }
  @keyframes pipe-draw {
    0% {
      stroke-dashoffset: 690;
    }
    82%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pipe-node {
    0%,
    2% {
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pipe-node-soft {
    0%,
    2% {
      opacity: 0;
    }
    6% {
      opacity: 0.3;
    }
    88% {
      opacity: 0.3;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pipe-pop {
    0%,
    80% {
      opacity: 0;
      transform: scale(0.5);
    }
    86% {
      opacity: 1;
      transform: scale(1.1);
    }
    90%,
    94% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(0.8);
    }
  }
</style>
