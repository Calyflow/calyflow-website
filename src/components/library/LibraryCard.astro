---
import type { LibraryItem } from '../../lib/library';

interface Props {
  item: LibraryItem;
  class?: string;
}

const { item, class: className } = Astro.props;
const href = `/automation-library/${item.slug}`;
const typeLabel = item.type === 'agent' ? 'Agent' : 'Workflow';
---

<a
  href={href}
  class:list={[
    'group flex flex-col overflow-hidden rounded-[20px] border border-navy-800/12 bg-white transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgba(19,31,56,0.08)] motion-reduce:hover:translate-y-0',
    className,
  ]}
  data-event={`library-card-${item.type}`}
>
  <div class="aspect-[1200/630] overflow-hidden bg-cream-100">
    <img
      src={item.coverUrl}
      alt={`${item.name} cover`}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
    />
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class:list={[
          'inline-flex items-center rounded-full px-2.5 py-0.5 font-mono text-[0.6875rem] leading-4',
          item.type === 'agent' ? 'bg-lavender-300/30 text-navy-800/75' : 'bg-mint-400/22 text-mint-700',
        ]}
      >
        {typeLabel}
      </span>
      {
        item.connectors.map((g) => (
          <span class="inline-flex items-center rounded-full bg-cream-100 px-2.5 py-0.5 font-mono text-[0.6875rem] leading-4 text-navy-800/60">
            {g.label}
          </span>
        ))
      }
    </div>

    <h3 class="mt-3 font-display text-lg font-semibold text-navy-900 group-hover:text-mint-700">
      {item.name}
    </h3>
    <p class="mt-2 line-clamp-3 text-[0.9375rem] leading-relaxed text-navy-800/65">
      {item.description}
    </p>

    <p class="mt-4 flex items-center gap-1.5 font-mono text-xs text-navy-800/55">
      <span class="text-mint-700">→</span>
      {item.output}
    </p>
  </div>
</a>
