---
// Framed screenshot for blog posts (MDX). Rounded, bordered, with an
// optional caption — keeps product screenshots on-brand inside prose.
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Constrain width for narrow UI shots (e.g. a single Slack thread). */
  width?: number;
}

const { src, alt, caption, width } = Astro.props;
---

<figure class="my-8">
  <img
    src={src}
    alt={alt}
    loading="lazy"
    style={width ? `max-width:${width}px` : undefined}
    class="mx-auto w-full rounded-card border border-navy-800/12 shadow-[0_2px_6px_rgba(19,31,56,0.06),0_16px_40px_-16px_rgba(19,31,56,0.22)]"
  />
  {
    caption && (
      <figcaption class="mt-3 text-center font-mono text-[0.8125rem] text-navy-800/55">
        {caption}
      </figcaption>
    )
  }
</figure>
