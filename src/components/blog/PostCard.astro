---
import type { CollectionEntry } from 'astro:content';
import TopicChip from './TopicChip.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="flex h-full flex-col rounded-card border border-navy-800/12 bg-white p-7 transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgba(19,31,56,0.08)] motion-reduce:hover:translate-y-0">
  <TopicChip topic={post.data.topic} />
  <h3 class="mt-4 font-display text-2xl leading-snug font-semibold">
    <a href={`/blog/${post.id}`} class="hover:text-mint-700">{post.data.title}</a>
  </h3>
  <p class="mt-3 flex-1 text-[0.9375rem] text-navy-800/65">{post.data.description}</p>
  <p class="mt-5 font-mono text-[0.8125rem] text-navy-800/55">
    <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{date}</time>
  </p>
</article>
