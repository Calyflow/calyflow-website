---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="font-mono text-[0.8125rem] text-navy-800/55">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      crumbs.map((crumb, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true">/</span>}
          {crumb.href ? (
            <a href={crumb.href} class="hover:text-mint-700">
              {crumb.label}
            </a>
          ) : (
            <span aria-current="page" class="text-navy-800/80">
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
