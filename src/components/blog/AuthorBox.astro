---
import { AUTHOR } from '../../data/site';
---

<aside class="flex items-start gap-4 rounded-card border border-navy-800/12 bg-white p-6">
  <img
    src={AUTHOR.avatar}
    alt={`Portrait of ${AUTHOR.name}`}
    width="56"
    height="56"
    loading="lazy"
    class="h-14 w-14 rounded-full"
  />
  <div>
    <p class="font-display font-semibold text-navy-900">{AUTHOR.name}</p>
    <p class="mt-1 text-sm text-navy-800/70">{AUTHOR.bio}</p>
    <a href={AUTHOR.linkedin} rel="noopener" class="mt-2 inline-block text-sm font-medium text-mint-700 hover:underline">
      Connect on LinkedIn
    </a>
  </div>
</aside>
