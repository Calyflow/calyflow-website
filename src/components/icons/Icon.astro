---
/**
 * Duotone-line icon set (DESIGN.md §5): 24×24 grid, 1.75px navy stroke,
 * round caps/joins, one closed shape filled mint-400 @22% as the highlight
 * (amber for warnings). Inline SVG, aria-hidden, always next to a text label.
 */
interface Props {
  name: keyof typeof icons;
  size?: 24 | 32 | 48;
  tone?: 'mint' | 'amber';
  class?: string;
}

const { name, size = 24, tone = 'mint', class: className } = Astro.props;
// Keep optical stroke weight consistent at larger sizes.
const strokeWidth = size >= 48 ? 1.5 : 1.75;
const fill = tone === 'amber' ? 'var(--color-amber-400)' : 'var(--color-mint-400)';

// Each icon = { duo: closed highlight shape(s), line: stroked detail paths }
const icons: Record<string, { duo: string; line: string }> = {
  'workflow-nodes': {
    duo: '<rect x="3" y="3" width="7" height="7" rx="2"/>',
    line: '<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/><circle cx="17.5" cy="6.5" r="2.5"/><path d="M10 6.5h5M6.5 10v4.5a3 3 0 0 0 3 3H14"/>',
  },
  'document-check': {
    duo: '<path d="M6 2.75h8.5L19 7.25V19a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4.75a2 2 0 0 1 2-2Z"/>',
    line: '<path d="M6 2.75h8.5L19 7.25V19a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4.75a2 2 0 0 1 2-2Z"/><path d="M14.5 2.75v4.5H19"/><path d="m8.5 14.5 2.5 2.5 4.5-4.5"/>',
  },
  'clients-building': {
    duo: '<rect x="4" y="6" width="10" height="15" rx="1.5"/>',
    line: '<rect x="4" y="6" width="10" height="15" rx="1.5"/><path d="M14 10h4.5a1.5 1.5 0 0 1 1.5 1.5V21H14"/><path d="M7.5 10h3M7.5 13.5h3M7.5 17h3M16.5 14h.01M16.5 17.5h.01"/><path d="M3 21h18"/>',
  },
  'ai-spark': {
    duo: '<path d="M12 3.5 14 9.5 20 11.5 14 13.5 12 19.5 10 13.5 4 11.5 10 9.5Z"/>',
    line: '<path d="M12 3.5 14 9.5 20 11.5 14 13.5 12 19.5 10 13.5 4 11.5 10 9.5Z"/><path d="M19 3.5v3M20.5 5h-3"/>',
  },
  'open-source-shield': {
    duo: '<path d="M12 2.75 19.5 5.5v6c0 4.5-3 8-7.5 9.75C7.5 19.5 4.5 16 4.5 11.5v-6Z"/>',
    line: '<path d="M12 2.75 19.5 5.5v6c0 4.5-3 8-7.5 9.75C7.5 19.5 4.5 16 4.5 11.5v-6Z"/><circle cx="12" cy="10.5" r="2.75"/><path d="M10.5 13 9 16.5M13.5 13l1.5 3.5"/>',
  },
  'integration-plug': {
    duo: '<path d="M8 7h8v4a4 4 0 0 1-4 4 4 4 0 0 1-4-4Z"/>',
    line: '<path d="M8 7h8v4a4 4 0 0 1-4 4 4 4 0 0 1-4-4Z"/><path d="M9.5 7V3.5M14.5 7V3.5M12 15v2.5a3 3 0 0 1-3 3H7"/>',
  },
  key: {
    duo: '<circle cx="8" cy="15.5" r="4.75"/>',
    line: '<circle cx="8" cy="15.5" r="4.75"/><path d="m11.5 12 8-8M16.5 7l2.5 2.5M13.75 9.75l2 2"/>',
  },
  database: {
    duo: '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.75"/>',
    line: '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.75"/><path d="M4.5 5.5v13c0 1.52 3.36 2.75 7.5 2.75s7.5-1.23 7.5-2.75v-13"/><path d="M4.5 12c0 1.52 3.36 2.75 7.5 2.75s7.5-1.23 7.5-2.75"/>',
  },
  magnet: {
    duo: '<path d="M5 4h4.5v9a2.5 2.5 0 0 0 5 0V4H19v9a7 7 0 0 1-14 0Z"/>',
    line: '<path d="M5 4h4.5v9a2.5 2.5 0 0 0 5 0V4H19v9a7 7 0 0 1-14 0Z"/><path d="M5 8h4.5M14.5 8H19"/>',
  },
  envelope: {
    duo: '<rect x="3" y="5" width="18" height="14" rx="2"/>',
    line: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 7.3 5.4a2 2 0 0 0 2.4 0L20.5 7"/>',
  },
  scorecard: {
    duo: '<rect x="4" y="3" width="16" height="18" rx="2"/>',
    line: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h4.5"/><path d="m8 16.5 1.75 1.75L13.5 14.5"/><path d="M16.5 17h.01"/>',
  },
  target: {
    duo: '<circle cx="12" cy="12" r="5"/>',
    line: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>',
  },
  rocket: {
    duo: '<path d="M12 3c3.5 1.5 5.5 5 5.5 9l-2.5 3h-6L6.5 12C6.5 8 8.5 4.5 12 3Z"/>',
    line: '<path d="M12 3c3.5 1.5 5.5 5 5.5 9l-2.5 3h-6L6.5 12C6.5 8 8.5 4.5 12 3Z"/><circle cx="12" cy="9.5" r="1.75"/><path d="M9 15.5 7.5 20l3-1.5M15 15.5 16.5 20l-3-1.5"/><path d="M12 18.5v2"/>',
  },
};

const icon = icons[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <g fill={fill} opacity="0.22" set:html={icon.duo} />
  <g
    fill="none"
    stroke="var(--color-navy-800)"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icon.line}
  />
</svg>
