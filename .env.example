# Base URL of the Calyflow library API the site builds against.
# Defaults to production (https://app.calyflow.ai/api/v1/library) when unset.
# Override to point the build/dev server at a local app API for previewing.
LIBRARY_API_URL=https://app.calyflow.ai/api/v1/library

# For local previews against a dev app API, use instead:
# LIBRARY_API_URL=http://localhost:3000/api/v1/library

# PostHog analytics. Public (client-side) keys — safe to expose in the browser.
# Get the project token from PostHog → Settings → Project.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
